{
  "_comment": "Replace this file with your real google-services.json from Firebase Console.",
  "_instructions": [
    "1. Go to https://console.firebase.google.com",
    "2. Create project 'HomeLifeSync' (or open existing)",
    "3. Add Android App with package name: com.homelifesync.elder",
    "4. Download google-services.json",
    "5. Copy it to: elder-helper/app/google-services.json",
    "6. Enable Realtime Database (Spark free plan)",
    "7. Enable Cloud Messaging (free, no action needed beyond enabling)"
  ],
  "project_info": {
    "project_id": "YOUR_PROJECT_ID",
    "firebase_url": "https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com",
    "project_number": "YOUR_PROJECT_NUMBER",
    "storage_bucket": "YOUR_PROJECT_ID.appspot.com"
  },
  "client": [
    {
      "client_info": {
        "android_client_info": {
          "package_name": "com.homelifesync.elder"
        }
      },
      "api_key": [{ "current_key": "YOUR_ANDROID_API_KEY" }],
      "services": {
        "appinvite_service": {
          "other_platform_oauth_client": []
        }
      }
    }
  ],
  "configuration_version": "1"
}
